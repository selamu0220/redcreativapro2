{
  "name": "escritor-ia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev --no-turbo",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "build:ionic": "node build-ionic.js",
    "start": "next start",
    "mobile:sync": "npx cap sync android",
    "mobile:build": "npx cap build android",
    "mobile:open": "npx cap open android",
    "mobile:run": "npx cap run android",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --chrome-flags=\"--headless\"",
    "lighthouse:ci": "lhci autorun",
    "check": "next lint && tsc --noEmit",
    "perf": "npm run build && npm run lighthouse",
    "dev:safe": "node dev-safe.js",
    "dev:clean": "rm -rf .next && npm run dev:safe",
    "health": "node webpack-health-check.js",
    "seo:list": "node scripts/seo-tools.js list",
    "seo:promote": "node scripts/seo-tools.js promote",
    "seo:gen": "node scripts/seo-tools.js gen",
    "seo:new": "node scripts/seo-new.js",
    "seo:suggest": "node scripts/seo-suggest.js",
    "seo:merge:ctr": "node scripts/seo-merge-ctr.js",
    "seo:apply:suggest": "node scripts/seo-apply-suggest.js",
    "seo:ctr:auto": "node scripts/seo-ctr-auto.js",
    "seo:weekly": "node scripts/seo-weekly-report-grouped.js",
    "seo:weekly:summary": "node scripts/seo-weekly-summary.js",
    "seo:weekly:actions": "node scripts/seo-weekly-actions.js",
    "seo:weekly:run": "node scripts/seo-weekly-run.js",
    "test": "vitest"
  },
