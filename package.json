  "scripts": {
    "dev": "next dev --turbopack",
    "dev:fast": "NEXT_TELEMETRY_DISABLED=1 next dev --turbopack --port 3000",
    "dev:clean": "rimraf .next && pnpm dev",
    "build": "paraglide-js compile --project ./project.inlang && next build",
    "build:turbo": "paraglide-js compile --project ./project.inlang && next build --turbopack",
    "build:ionic": "node build-ionic.js",
    "start": "next start",
