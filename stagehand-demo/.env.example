# OpenAI API Key (Required for Stagehand AI processing)
OPENAI_API_KEY=sk-your-key-here

# Optional: Browserbase API Key and Project ID (for cloud execution)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional: ANTHROPIC_API_KEY if supported/configured
# ANTHROPIC_API_KEY=

# If using OpenRouter, you might try:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=your-openrouter-key
