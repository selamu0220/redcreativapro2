# Configuración de Gmail para envío de correos
# IMPORTANTE: Debes generar una contraseña de aplicación en tu cuenta de Gmail
# Ve a: Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones

# Tu email de Gmail
GMAIL_USER=tu-email@gmail.com

# Contraseña de aplicación de Gmail (NO tu contraseña normal)
# Debe ser una contraseña de 16 caracteres generada por Google
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# API Key de Google Gemini para IA
GEMINI_API_KEY=your_gemini_api_key_here

# Configuración adicional
NEXT_PUBLIC_APP_URL=https://www.redcreativa.pro

# Configuración de Firebase (opcional para desarrollo local)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id

# Configuración de Vercel KV (opcional para desarrollo local)
# KV_REST_API_URL=your_kv_rest_api_url
# KV_REST_API_TOKEN=your_kv_rest_api_token

# Configuración de PostgreSQL (opcional para desarrollo local)
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# POSTGRES_ADMIN_URL=postgresql://admin:password@localhost:5432/postgres

# Configuración de Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ElevenLabs API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Stripe Configuration (for payments)
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Google Analytics 4 Configuration
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HQT95MVX91

# Google Ads Configuration
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-17079639721

# Umami Analytics Configuration
NEXT_PUBLIC_UMAMI_WEBSITE_ID=5ee8a0c8-dfcb-455c-8ef0-6cd1dab9669b
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_DOMAINS=www.redcreativa.pro,redcreativa.pro