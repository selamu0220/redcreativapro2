# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP Configuration (Optional - for email sending feature)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Firebase Configuration (if using Firebase features)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Next.js Configuration
NODE_ENV=production
PORT=3000

# Google Sheets Configuration (NUEVA ALTERNATIVA A BASE DE DATOS)
# Para obtener estas credenciales:
# 1. Ve a Google Cloud Console (https://console.cloud.google.com/)
# 2. Crea un nuevo proyecto o selecciona uno existente
# 3. Habilita la API de Google Sheets
# 4. Crea una cuenta de servicio en IAM & Admin > Service Accounts
# 5. Genera una clave JSON para la cuenta de servicio
# 6. Crea una hoja de cálculo en Google Sheets
# 7. Comparte la hoja con el email de la cuenta de servicio (con permisos de editor)
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_CLIENT_EMAIL=tu-cuenta-servicio@tu-proyecto.iam.gserviceaccount.com
GOOGLE_SHEETS_SPREADSHEET_ID=1BxiMVs0XRA5nFMdXXXXXXXXXXXXXXXXXXXXXXX

# Vercel KV Configuration (opcional)
KV_URL=your_kv_url
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token

# Resend API (para envío de emails)
RESEND_API_KEY=your_resend_api_key

# Web3Forms Configuration (NUEVA ALTERNATIVA SIMPLE PARA FORMULARIOS)
# Para obtener tu Access Key:
# 1. Ve a https://web3forms.com/
# 2. Ingresa tu email y crea una cuenta gratuita
# 3. Copia tu Access Key desde el dashboard
# 4. No es secreto, puede ser público en el frontend
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Directorio de datos (para desarrollo local)
DATA_DIR=./data