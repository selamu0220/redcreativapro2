{
  "name": "escritor-ia",
  "integrations": {
    "capacitor": {}
  },
  "type": "custom",
  "hooks": {
    "build:before": [
      {
        "name": "Mobile Build Setup",
        "command": "echo 'Starting mobile build process...'"
      }
    ],
    "build:after": [
      {
        "name": "Verify Dist Directory",
        "command": "ls -la dist/ || echo 'dist directory not found'"
      }
    ]
  },
  "build": {
    "command": "npm run build:ionic",
    "outputPath": "dist"
  }
}