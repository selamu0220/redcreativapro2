<?xml version="1.0" encoding="UTF-8"?>
<svg width="1080" height="1920" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
  <defs>
    <linearGradient id="bg0" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea"/>
      <stop offset="100%" style="stop-color:#764ba2"/>
    </linearGradient>
    <filter id="glow0">
      <feGaussianBlur stdDeviation="10" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <clipPath id="circle0">
      <circle cx="540" cy="300" r="60"/>
    </clipPath>
  </defs>
  
  <!-- Animated Background -->
  <rect width="100%" height="100%" fill="url(#bg0)">
    <animate attributeName="opacity" values="0.9;1;0.9" dur="4s" repeatCount="indefinite"/>
  </rect>
  
  <!-- Floating Particles -->
  
    <circle cx="200" cy="500" r="3" fill="#667eea" opacity="0.4">
      <animate attributeName="cy" values="500;470;500" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.4;0.7;0.4" dur="2s" repeatCount="indefinite"/>
    </circle>
  
    <circle cx="800" cy="600" r="5" fill="#764ba2" opacity="0.4">
      <animate attributeName="cy" values="600;570;600" dur="4s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.4;0.7;0.4" dur="2.5s" repeatCount="indefinite"/>
    </circle>
  
    <circle cx="300" cy="1400" r="7" fill="#f093fb" opacity="0.4">
      <animate attributeName="cy" values="1400;1370;1400" dur="5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.4;0.7;0.4" dur="3s" repeatCount="indefinite"/>
    </circle>
  
    <circle cx="700" cy="1500" r="9" fill="#f5576c" opacity="0.4">
      <animate attributeName="cy" values="1500;1470;1500" dur="6s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.4;0.7;0.4" dur="3.5s" repeatCount="indefinite"/>
    </circle>
  
  
  <!-- Logo Circle with Animation -->
  <g transform="translate(540, 300)">
    <circle cx="0" cy="0" r="70" fill="rgba(255,255,255,0.2)" filter="url(#glow0)">
      <animate attributeName="r" values="70;75;70" dur="2s" repeatCount="indefinite"/>
    </circle>
    <circle cx="0" cy="0" r="60" fill="white"/>
    <text x="0" y="20" font-size="50" text-anchor="middle">⚡</text>
  </g>
  
  <!-- Animated Line -->
  
  <line x1="340" y1="420" x2="740" y2="420" stroke="rgba(255,255,255,0.5)" stroke-width="4" stroke-linecap="round">
    <animate attributeName="x2" from="340" to="740" dur="1s" begin="0s" fill="freeze"/>
  </line>
  
  
  <!-- Title with Animation -->
  <text x="540" y="600" font-family="system-ui, -apple-system, sans-serif" font-size="56" font-weight="800" fill="white" text-anchor="middle">
    <tspan x="540" dy="0">RedCreativa Pro</tspan>
    <animate attributeName="opacity" from="0" to="1" dur="0.5s" begin="0.5s" fill="freeze"/>
    <animateTransform attributeName="transform" type="translate" from="0 30" to="0 0" dur="0.5s" begin="0.5s" fill="freeze"/>
  </text>
  
  <!-- Subtitle -->
  <text x="540" y="900" font-family="system-ui, -apple-system, sans-serif" font-size="32" fill="rgba(255,255,255,0.85)" text-anchor="middle">
    Comunidad de creadores
    <animate attributeName="opacity" from="0" to="1" dur="0.5s" begin="1s" fill="freeze"/>
  </text>
  
  <!-- Decorative Elements -->
  <circle cx="100" cy="1700" r="30" fill="rgba(255,255,255,0.1)">
    <animate attributeName="r" values="30;40;30" dur="3s" repeatCount="indefinite"/>
  </circle>
  <circle cx="980" cy="1800" r="20" fill="rgba(255,255,255,0.15)">
    <animate attributeName="r" values="20;30;20" dur="2.5s" repeatCount="indefinite"/>
  </circle>
</svg>