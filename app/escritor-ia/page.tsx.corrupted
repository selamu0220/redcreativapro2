    setCurrentDocumentId(null);
    setSaveAsNew(false);
    
    // Limpiar historial de versiones
    setVersionHistory([]);
    setIsShowingVersions(false);
    setCurrentVersionIndex(-1);
  };

  const handleSaveAs = () => {
